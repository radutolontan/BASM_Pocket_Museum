[Unit]
Description=Pocket Lab UDP Listener
After=network.target pocketlab.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard
Environment="PATH=/home/pi/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard/venv/bin"
ExecStart=/home/pi/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard/venv/bin/python udp_listener.py

# Restart policy
Restart=always
RestartSec=5

# Resource limits
LimitNOFILE=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pocketlab-listener

[Install]
WantedBy=multi-user.target
