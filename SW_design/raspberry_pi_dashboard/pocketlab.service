[Unit]
Description=Pocket Lab Dashboard - WSGI Server
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=notify
User=basm
Group=basm
WorkingDirectory=/home/basm/code/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard
Environment="PATH=/home/basm/code/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard/venv/bin"
Environment="DISABLE_UDP_LISTENER=1"
ExecStart=/home/basm/code/BASM_Pocket_Museum/SW_design/raspberry_pi_dashboard/venv/bin/gunicorn \
    --config gunicorn_config.py \
    --worker-class eventlet \
    --workers 3 \
    --bind 127.0.0.1:8080 \
    "app:app"

# Automatically create runtime and log directories on startup
RuntimeDirectory=pocketlab
LogsDirectory=pocketlab

# Restart policy
Restart=always
RestartSec=5

# Resource limits (optional - adjust based on Raspberry Pi model)
LimitNOFILE=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pocketlab

[Install]
WantedBy=multi-user.target
